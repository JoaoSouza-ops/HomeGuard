# Copie para .env (cp .env.example .env) e ajuste. NUNCA commite o .env.
# ===== VALORES PARA RODAR NO SEU COMPUTADOR (padrão) =====

DATABASE_URL=sqlite:////app/data/homeguard.db
MQTT_BROKER_HOST=mosquitto

# Portas locais (8080 evita conflito com programas que já usam a porta 80 no Windows)
HTTP_PORT=8080
HTTPS_PORT=8443
CADDYFILE=Caddyfile.local

# Embutidas no frontend no BUILD
VITE_API_URL=/api
VITE_WS_URL=ws://localhost:8080/api

# ===== NA AWS (.env da EC2) — troque pelos valores abaixo =====
# HTTP_PORT=80
# HTTPS_PORT=443
# CADDYFILE=Caddyfile.prod
# SITE_ADDRESS=SEU-IP-COM-HIFENS.sslip.io        # ex.: 3-91-10-20.sslip.io
# BASIC_USER=homeguard
# BASIC_HASH='COLE_AQUI_O_HASH'                   # ver GUIA, passo da senha (use aspas simples!)
# VITE_API_URL=/api
# VITE_WS_URL=wss://SEU-IP-COM-HIFENS.sslip.io/api
